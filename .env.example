# Copia este archivo como ".env" y completa tus valores reales.
# Nunca subas el archivo ".env" a GitHub.

# Cadena de conexión a PostgreSQL.
# Opción gratuita fácil: crea un proyecto en https://supabase.com o https://neon.tech
# y copia la "Connection string" que te dan.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/global7

# Clave secreta para firmar los tokens de sesión (JWT).
# Genera una aleatoria, por ejemplo con: openssl rand -hex 32
SECRET_KEY=cambia-esta-clave-en-produccion

# Tu API key de Anthropic (para Global AI).
# La obtienes en https://console.anthropic.com
ANTHROPIC_API_KEY=tu-api-key-aqui

# Claves de Mercado Pago — las obtienes en
# https://www.mercadopago.cl/developers/panel (crea una app > Credenciales de prueba)
MP_ACCESS_TOKEN=TEST-tu-access-token-aqui

# URL pública de tu backend (Mercado Pago necesita poder llamarla para
# el webhook). En local, usa ngrok — ver README para el paso a paso.
BACKEND_URL=http://localhost:8000

# URL de tu frontend, para redirigir tras el pago
FRONTEND_URL=http://localhost:3000

# En producción, restringe CORS a tu dominio real (separados por coma
# si tienes más de uno). En desarrollo puedes dejarlo en *.
ALLOWED_ORIGINS=*

# Cloudflare R2 (almacenamiento de imágenes) — ver README para el paso a paso
R2_ACCOUNT_ID=tu-account-id
R2_ACCESS_KEY_ID=tu-access-key-id
R2_SECRET_ACCESS_KEY=tu-secret-access-key
R2_BUCKET_NAME=global7-uploads
R2_PUBLIC_URL=https://pub-tu-id.r2.dev

# Porcentaje de comisión de la plataforma sobre cada venta
COMISION_PORCENTAJE=8

# Datos bancarios para pagos por transferencia manual (se muestran al
# comprador cuando elige "Transferencia bancaria" en vez de Mercado Pago)
BANCO_NOMBRE=Banco de Chile
BANCO_TIPO_CUENTA=Cuenta Corriente
BANCO_NUMERO_CUENTA=00-000-00000-00
BANCO_RUT=11.111.111-1
BANCO_TITULAR=Tu Nombre o Empresa
BANCO_EMAIL=tu-email@ejemplo.com
